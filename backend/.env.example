PORT=8000
NODE_ENV=production
JWT_SECRET=replace-with-strong-64-char-random-secret
DEFAULT_ADMIN_EMAIL=admin@jklu.edu.in
DEFAULT_ADMIN_PASSWORD=replace-with-strong-admin-password

# PostgreSQL (Neon / Supabase / RDS / Railway)
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
PG_POOL_MAX=50

# Optional Cloudflare R2 / S3 CDN URL for zero-copy PDF delivery
PUBLIC_BASE_URL=https://api.learnjklu.in
CDN_BASE_URL=https://cdn.learnjklu.in

# Optional Email Provider (Resend or SMTP)
RESEND_API_KEY=re_xxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@jklu.edu.in
