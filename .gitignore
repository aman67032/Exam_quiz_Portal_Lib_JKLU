# ============================================================================
# Learn JKLU — Monorepo .gitignore
# ============================================================================

# Past Paper PDFs & Binary Archives (stored locally / in Neon BYTEA)
pastpaper/
pastpaper_bin/
backend/storage/
backend/data/
*.bin

# Environment & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Next.js / Frontend Build Artifacts
.next/
**/.next/
dist/
dist-ssr/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Logs & Runtime Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS Files
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/*
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
